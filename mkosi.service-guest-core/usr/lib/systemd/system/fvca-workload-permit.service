[Unit]
Description=Report expiry and enforce revocation of the mounted unsigned-source permit
Requisite=fvca-workload-root.service
After=fvca-workload-root.service
ConditionPathExists=/run/fvca/workload-image/permit.json
AssertPathIsMountPoint=/run/fvca/guest-data
AssertSecurity=|uefi-secureboot
AssertPathExists=|/run/fvca/direct-boot-ready
AssertSecurity=selinux

[Service]
Type=oneshot
ExecStart=/usr/lib/fvca/activate-workload monitor-permit
TimeoutStartSec=45s
CapabilityBoundingSet=
NoNewPrivileges=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
ProtectSystem=strict
ReadWritePaths=-/run/fvca/workload-image/permit-status /run/fvca/workload-lifecycle.lock
UMask=0077
StandardOutput=journal+console
StandardError=journal+console
