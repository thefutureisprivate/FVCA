[Unit]
Description=Start the authorized Service Guest workload
ConditionPathIsDirectory=/run/fvca/workload-trust
AssertSecurity=|uefi-secureboot
AssertPathExists=|/run/fvca/direct-boot-ready
AssertSecurity=selinux
Requires=fvca-workload-root.service
Wants=fvca-stage-workload.service fvca-workload-update.timer fvca-workload-permit.timer
After=fvca-workload-root.service
Before=fvca-base-ready.service
OnFailure=emergency.target

[Service]
Type=oneshot
ExecStart=/usr/lib/fvca/activate-workload start
RemainAfterExit=yes
TimeoutStartSec=110s
NoNewPrivileges=yes
MemoryDenyWriteExecute=yes
StandardOutput=journal+console
