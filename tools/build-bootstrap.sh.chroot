#!/usr/bin/bash
set -euo pipefail
source "$SRCDIR/tools/allocator-source.env"

build_dir=$(mktemp -d)
trap 'rm -rf "$build_dir"' EXIT
export CARGO_HOME="$build_dir/cargo"
export CARGO_TARGET_DIR="$build_dir/target"
export RUSTFLAGS="-Dwarnings"

target=x86_64-unknown-linux-gnu
cargo build --frozen --release --target "$target" --bin fvca-initrd-bootstrap \
    --manifest-path "$SRCDIR/bootstrap/Cargo.toml"

bootstrap="$DESTDIR/usr/lib/fvca/initrd-bootstrap"
install -Dm755 "$CARGO_TARGET_DIR/$target/release/fvca-initrd-bootstrap" "$bootstrap"
patchelf --add-needed "$allocator_library" "$bootstrap"
dependencies=$(patchelf --print-needed "$bootstrap")
test "${dependencies%%$'\n'*}" = "$allocator_library"
ln -s /usr/lib/fvca/initrd-bootstrap "$DESTDIR/init"
