#!/usr/bin/bash
set -euo pipefail

build_dir=$(mktemp -d)
trap 'rm -rf "$build_dir"' EXIT
export CARGO_HOME="$build_dir/cargo"
export CARGO_TARGET_DIR="$build_dir/target"
export RUSTFLAGS="-Dwarnings"

target=x86_64-unknown-linux-gnu
cargo build --frozen --release --target "$target" --bin fvca-exec-check \
    --manifest-path "$SRCDIR/bootstrap/Cargo.toml"

unit_dir="$DESTDIR/usr/lib/systemd/system"
install -Dm755 "$CARGO_TARGET_DIR/$target/release/fvca-exec-check" "$DESTDIR/usr/lib/fvca/exec-check"
install -Dm644 "$SRCDIR/tests/fvca-exec-check.service" "$unit_dir/fvca-exec-check.service"
install -Dm644 "$SRCDIR/tests/exec-check.conf" "$unit_dir/fvca-base-ready.service.d/40-exec-check.conf"
