-	    !fu_dbus_daemon_approved_version(protocol, version, format, version_raw)) {
+	    strlen(identity.device_id) != 40 || strspn(identity.device_id, "0123456789abcdef") != 40 ||
+	    strlen(identity.archive_sha256) != 64 || strlen(identity.payload_sha256) != 64 ||
+	    strlen(identity.guid) != 36 ||
+	    !fu_dbus_daemon_approved_version(identity.protocol, identity.from, identity.format, identity.from_raw) ||
+	    !fu_dbus_daemon_approved_version(identity.protocol, identity.to, identity.format, identity.to_raw)) {
@@ -2191 +2273 @@
