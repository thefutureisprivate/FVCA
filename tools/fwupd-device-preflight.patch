@@ -2040,0 +2041,73 @@
+typedef struct {
+	const gchar *device_id;
+	const gchar *archive_sha256;
+	const gchar *payload_sha256;
+	const gchar *guid;
+	const gchar *protocol;
+	const gchar *from;
+	const gchar *to;
+	const gchar *format;
+	guint32 from_raw;
+	guint32 to_raw;
+} FuFvcaCabinet;
+
+static gboolean
+fu_dbus_daemon_check_fvca_device(FuEngine *engine,
+				FuCabinet *cabinet,
+				XbNode *component,
+				XbNode *selected,
+				const FuFvcaCabinet *identity,
+				gboolean *capsule_on_disk,
+				GError **error)
+{
+	const gboolean capsule = g_strcmp0(identity->protocol, "org.uefi.capsule") == 0;
+	const FwupdDeviceFlags excluded =
+	    FWUPD_DEVICE_FLAG_EMULATED | FWUPD_DEVICE_FLAG_HISTORICAL |
+	    FWUPD_DEVICE_FLAG_UNREACHABLE | FWUPD_DEVICE_FLAG_LOCKED |
+	    FWUPD_DEVICE_FLAG_UPDATABLE_HIDDEN | FWUPD_DEVICE_FLAG_NEEDS_ACTIVATION |
+	    FWUPD_DEVICE_FLAG_NEEDS_SHUTDOWN | FWUPD_DEVICE_FLAG_NEEDS_BOOTLOADER |
+	    FWUPD_DEVICE_FLAG_IS_BOOTLOADER | FWUPD_DEVICE_FLAG_WAIT_FOR_REPLUG |
+	    FWUPD_DEVICE_FLAG_ANOTHER_WRITE_REQUIRED | FWUPD_DEVICE_FLAG_WILL_DISAPPEAR |
+	    FWUPD_DEVICE_FLAG_INSTALL_ALL_RELEASES | FWUPD_DEVICE_FLAG_WILDCARD_INSTALL |
+	    FWUPD_DEVICE_FLAG_INSTALL_SKIP_VERSION_CHECK;
+	g_autoptr(FuDevice) device = fu_engine_get_device(engine, identity->device_id, error);
+	g_autoptr(FuEngineRequest) request = fu_engine_request_new(NULL);
+	g_autoptr(FuRelease) release = fu_release_new();
+
+	if (device == NULL) {
+		g_prefix_error_literal(error, "approved live firmware device is unavailable: ");
+		return FALSE;
+	}
+	if (g_strcmp0(fu_device_get_id(device), identity->device_id) != 0 ||
+	    g_strcmp0(fu_device_get_plugin(device), capsule ? "uefi_capsule" : "nvme") != 0 ||
+	    !fu_device_has_guid(device, identity->guid) ||
+	    !fu_device_has_protocol(device, identity->protocol) ||
+	    g_strcmp0(fu_device_get_version(device), identity->from) != 0 ||
+	    fu_device_get_version_raw(device) != identity->from_raw ||
+	    fu_device_get_version_format(device) != fwupd_version_format_from_string(identity->format) ||
+	    !fu_device_has_flag(device, FWUPD_DEVICE_FLAG_INTERNAL) ||
+	    !fu_device_has_flag(device, FWUPD_DEVICE_FLAG_UPDATABLE) ||
+	    (fwupd_device_get_flags(FWUPD_DEVICE(device)) & excluded) != 0 ||
+	    fwupd_device_get_problems(FWUPD_DEVICE(device)) != 0) {
+		g_set_error_literal(error, FWUPD_ERROR, FWUPD_ERROR_NOT_SUPPORTED,
+				    "live device differs from the approved firmware baseline or is inhibited");
+		return FALSE;
+	}
+
+	/* Run the native release and engine checks with a fresh request and no override flags. */
+	fu_release_set_device(release, device);
+	fu_release_set_request(release, request);
+	if (!fu_release_load(release, cabinet, component, selected, FWUPD_INSTALL_FLAG_NONE, error) ||
+	    !fu_engine_requirements_check(engine, release, FWUPD_INSTALL_FLAG_NONE, error) ||
+	    !fu_engine_check_trust(engine, release, error))
+		return FALSE;
+	if (g_strcmp0(fu_release_get_version(release), identity->to) != 0) {
+		g_set_error_literal(error, FWUPD_ERROR, FWUPD_ERROR_INVALID_FILE,
+				    "native release version differs from the approved firmware target");
+		return FALSE;
+	}
+	*capsule_on_disk = capsule &&
+	    g_strcmp0(G_OBJECT_TYPE_NAME(device), "FuUefiCodDevice") == 0;
+	return TRUE;
+}
+
