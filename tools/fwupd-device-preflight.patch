+	if (g_strcmp0(digest, identity.archive_sha256) != 0) {
@@ -2197,2 +2279,2 @@
-	verified = fu_dbus_daemon_verify_cabinet(engine, stream, guid, protocol, version, version_raw,
-					      payload_sha256, &payload_size, &error);
+	verified = fu_dbus_daemon_verify_cabinet(engine, stream, &identity,
+					      &payload_size, &capsule_on_disk, &error);
@@ -2202 +2284,2 @@
