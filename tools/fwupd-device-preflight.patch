+	g_variant_get(parameters, "(&s&s&s&s&s&s&s&suuh)",
+		      &identity.device_id, &identity.archive_sha256, &identity.payload_sha256,
+		      &identity.guid, &identity.protocol, &identity.from, &identity.to,
+		      &identity.format, &identity.from_raw, &identity.to_raw, &handle);
