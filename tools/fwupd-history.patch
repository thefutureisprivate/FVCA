+static void
+fu_dbus_daemon_method_get_fvca_result(FuDbusDaemon *self,
+				    GVariant *parameters,
+				    FuEngineRequest *request,
+				    GDBusMethodInvocation *invocation)
+{
+	FuEngine *engine = fu_daemon_get_engine(FU_DAEMON(self));
+	const gchar *id, *transaction, *offer_sha256;
+	FwupdRelease *release;
+	FwupdUpdateState state;
+	const gchar *version, *protocol;
+	g_autofree gchar *operation = NULL;
+	g_autoptr(FuDevice) device = NULL;
+	g_autoptr(GError) error = NULL;
+
+	g_variant_get(parameters, "(&s&s&s)", &id, &transaction, &offer_sha256);
+	if (!fu_engine_request_has_converter_flag(request, FWUPD_CODEC_FLAG_TRUSTED) ||
+	    g_strcmp0(g_getenv("FVCA_FWUPD_PERSISTENT_HISTORY"), "1") != 0 ||
+	    strlen(id) != 40 || strspn(id, "0123456789abcdef") != 40 ||
+	    !g_uuid_string_is_valid(transaction) ||
+	    strlen(offer_sha256) != 64 || strspn(offer_sha256, "0123456789abcdef") != 64) {
+		g_dbus_method_invocation_return_error_literal(invocation, G_DBUS_ERROR,
+							      G_DBUS_ERROR_ACCESS_DENIED,
+							      "FVCA requires one exact history operation");
+		return;
+	}
+	device = fu_engine_get_fvca_history(engine, id, &error);
+	if (device == NULL) {
+		fu_dbus_daemon_method_invocation_return_gerror(invocation, error);
+		return;
+	}
+	release = fu_device_get_release_default(device);
+	state = fu_device_get_update_state(device);
+	operation = g_strdup_printf("%s:%s", transaction, offer_sha256);
+	if (release == NULL ||
+	    fu_device_has_flag(device, FWUPD_DEVICE_FLAG_EMULATED) ||
+	    g_strcmp0(fu_release_get_metadata_item(FU_RELEASE(release), "FvcaOperation"), operation) != 0 ||
+	    (state != FWUPD_UPDATE_STATE_SUCCESS && state != FWUPD_UPDATE_STATE_FAILED &&
+	     state != FWUPD_UPDATE_STATE_FAILED_TRANSIENT)) {
+		g_dbus_method_invocation_return_error_literal(invocation, FWUPD_ERROR,
+							      FWUPD_ERROR_NOTHING_TO_DO,
+							      "FVCA has no terminal result for this operation");
+		return;
+	}
+	version = fwupd_release_get_version(release);
+	protocol = fwupd_release_get_protocol(release);
+	if (version == NULL || strlen(version) == 0 || strlen(version) > 64 ||
+	    (g_strcmp0(protocol, "org.uefi.capsule") != 0 &&
+	     g_strcmp0(protocol, "org.nvmexpress") != 0)) {
+		g_dbus_method_invocation_return_error_literal(invocation, FWUPD_ERROR,
+							      FWUPD_ERROR_INVALID_DATA,
+							      "FVCA history lacks a valid version and protocol");
+		return;
+	}
+	g_dbus_method_invocation_return_value(invocation,
+					      g_variant_new("(ssu)", version, protocol, (guint)state));
+}
+
