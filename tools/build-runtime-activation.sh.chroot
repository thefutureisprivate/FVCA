#!/usr/bin/bash
set -euo pipefail

build_dir=$(mktemp -d)
trap 'rm -rf "$build_dir"' EXIT
export CARGO_HOME="$build_dir/cargo"
export CARGO_TARGET_DIR="$build_dir/target"
export RUSTFLAGS="-Dwarnings"

target=x86_64-unknown-linux-gnu
binaries=(fvca-activate-runtime fvca-check-hypervisor-epoch fvca-set-boot-next fvca-set-boot-order fvca-verify-boot-approval)
features=(--features promotion)
if [[ -n "${FVCA_GUEST_DATA_SELECTION:-}" ]]; then
    binaries=(fvca-activate-guest-data)
    features=()
    install -Dm644 "$SRCDIR/$FVCA_GUEST_DATA_SELECTION" "$DESTDIR/usr/lib/fvca/guest-data"
    if [[ "${FVCA_GUEST_OCI:-}" == yes ]]; then
        binaries+=(fvca-activate-oci-runtime)
    fi
fi
arguments=()
for binary in "${binaries[@]}"; do arguments+=(--bin "$binary"); done
cargo build --frozen --release --target "$target" --manifest-path "$SRCDIR/bootstrap/Cargo.toml" "${features[@]}" "${arguments[@]}"
for binary in "${binaries[@]}"; do
    install -Dm755 "$CARGO_TARGET_DIR/$target/release/$binary" "$DESTDIR/usr/lib/fvca/${binary#fvca-}"
done
if [[ "${binaries[0]}" == fvca-activate-runtime ]]; then
    install -Dm644 /dev/null "$DESTDIR/usr/lib/fvca/host-storage-support-v4"
    install -Dm644 /dev/null "$DESTDIR/usr/lib/fvca/host-storage-tpm-auto-support-v1"
    install -Dm644 /dev/null "$DESTDIR/usr/lib/fvca/hypervisor-slot-support-v1"
    install -Dm644 /dev/null "$DESTDIR/usr/lib/fvca/hypervisor-trial-support-v3"
    install -Dm644 /dev/null "$DESTDIR/usr/lib/fvca/hypervisor-trial-watchdog-v1"
    install -Dm644 /dev/null "$DESTDIR/usr/lib/fvca/guest-trial-enrollment-v1"
    install -Dm644 /dev/null "$DESTDIR/usr/lib/fvca/guest-os-update-enrollment-v1"
    install -Dm644 /dev/null "$DESTDIR/usr/lib/fvca/firmware-update-enrollment-v10"
    install -Dm644 /dev/null "$DESTDIR/usr/lib/fvca/hypervisor-promotion-support-v2"
    install -Dm644 /dev/null "$DESTDIR/usr/lib/fvca/hypervisor-standing-trial-support-v5"
    install -Dm644 /dev/null "$DESTDIR/usr/lib/fvca/hypervisor-update-support-v2"
    install -Dm644 /dev/null "$DESTDIR/usr/lib/fvca/hypervisor-standing-promotion-v1"
fi
