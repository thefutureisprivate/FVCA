#!/usr/bin/bash
set -euo pipefail

build_dir=$(mktemp -d)
trap 'rm -rf "$build_dir"' EXIT
export CARGO_HOME="$build_dir/cargo"
export CARGO_TARGET_DIR="$build_dir/target"
export RUSTFLAGS="-Dwarnings"

target=x86_64-unknown-linux-gnu
cargo build --frozen --release --target "$target" --bin fvca-qualify-libvirt --bin fvca-launch-guest --bin fvca-backup-worker \
    --bin fvca-trial-health \
    --features libvirt,backup,promotion \
    --manifest-path "$SRCDIR/bootstrap/Cargo.toml"
for program in qualify-libvirt launch-guest backup-worker trial-health; do
    install -Dm755 "$CARGO_TARGET_DIR/$target/release/fvca-$program" "$DESTDIR/usr/libexec/fvca/$program"
done
install -Dm644 /dev/null "$DESTDIR/usr/libexec/fvca/trial-health-watchdog-v2"
install -Dm644 /dev/null "$DESTDIR/usr/lib/fvca/guest-vm-settings-v2"
install -Dm644 /dev/null "$DESTDIR/usr/lib/fvca/host-workload-network-v1"
