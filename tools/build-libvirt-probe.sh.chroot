#!/usr/bin/bash
set -euo pipefail

build_dir=$(mktemp -d)
trap 'rm -rf "$build_dir"' EXIT
export CARGO_HOME="$build_dir/cargo"
export CARGO_TARGET_DIR="$build_dir/target"
export RUSTFLAGS="-Dwarnings"

target=x86_64-unknown-linux-gnu
cargo build --frozen --release --target "$target" --bin fvca-qualify-libvirt --features libvirt \
    --manifest-path "$SRCDIR/bootstrap/Cargo.toml"
install -Dm755 "$CARGO_TARGET_DIR/$target/release/fvca-qualify-libvirt" \
    "$DESTDIR/usr/libexec/fvca/qualify-libvirt"
