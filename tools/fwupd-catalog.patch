+static GBytes *
+fu_dbus_daemon_read_catalog_fd(gint fd, goffset limit, GError **error)
+{
+	const gint required = F_SEAL_WRITE | F_SEAL_SHRINK | F_SEAL_GROW | F_SEAL_SEAL | F_SEAL_EXEC;
+	const gint seals = fcntl(fd, F_GET_SEALS);
+	struct stat st;
+	g_autoptr(FuInputStream) stream = NULL;
+
+	if (seals < 0 || (seals & required) != required || fstat(fd, &st) != 0 ||
+	    !S_ISREG(st.st_mode) || (st.st_mode & 0111) != 0 || st.st_size <= 0 ||
+	    st.st_size > limit) {
+		g_set_error_literal(error, FWUPD_ERROR, FWUPD_ERROR_INVALID_FILE,
+				    "expected a bounded, sealed, non-executable catalog descriptor");
+		return NULL;
+	}
+	stream = fu_unix_seekable_input_stream_new(fd, FALSE, error);
+	if (stream == NULL)
+		return NULL;
+	return fu_input_stream_read_bytes(stream, 0, (gsize)st.st_size, NULL, error);
+}
+#endif
