#!/usr/bin/bash
set -euo pipefail
source "$SRCDIR/tools/allocator-source.env"

build_dir=$(mktemp -d)
trap 'rm -rf "$build_dir"' EXIT
export CARGO_HOME="$build_dir/cargo"
export CARGO_TARGET_DIR="$build_dir/target"
mkdir "$CARGO_HOME"
lock=$(sha256sum "$SRCDIR/workload-admission/Cargo.lock")
vendor="$SRCDIR/build/workload-admission-vendor/${lock%% *}"
release_vendor="$SRCDIR/build/release-client-vendor/sources"
if [[ "${FVCA_OBS_VENDOR:-}" == yes ]]; then
    (
        cd "$SRCDIR/build/obs-inputs"
        sha256sum --check --strict fvca-rust-vendor.sha256
        mkdir "$build_dir/vendor"
        tar --zstd -xf fvca-rust-vendor.tar.zst -C "$build_dir/vendor"
    )
    vendor="$build_dir/vendor"
    release_vendor="$vendor"
fi
if [[ ! -d "$vendor" ]]; then
    echo 'Prepare the checksum-locked workload dependencies with tools/fetch-workload-admission.sh' >&2
    exit 1
fi
cat > "$CARGO_HOME/config.toml" <<EOF
[source.crates-io]
replace-with = "fvca-vendor"

[source.fvca-vendor]
directory = "$vendor"
EOF
target=x86_64-unknown-linux-gnu
# Keep temporary vendor paths out of compiled source locations and panic messages.
CARGO_ENCODED_RUSTFLAGS="-Dwarnings"$'\x1f'"--remap-path-prefix=$vendor=/usr/src/fvca/vendor" \
cargo build --frozen --release --target "$target" --bin fvca-activate-workload \
    --manifest-path "$SRCDIR/workload-admission/Cargo.toml"

activation="$DESTDIR/usr/lib/fvca/activate-workload"
install -Dm755 "$CARGO_TARGET_DIR/$target/release/fvca-activate-workload" "$activation"
patchelf --add-needed "$allocator_library" "$activation"
dependencies=$(patchelf --print-needed "$activation")
test "${dependencies%%$'\n'*}" = "$allocator_library"

# The Guest links only the shared intake library and the workload client.
if [[ ! -d "$release_vendor" ]]; then
    echo 'Prepare the checksum-locked release-client sources before building the Guest' >&2
    exit 1
fi
cat > "$CARGO_HOME/config.toml" <<EOF
[source.crates-io]
replace-with = "fvca-vendor"

[source.fvca-vendor]
directory = "$release_vendor"
EOF
export PKG_CONFIG=/usr/bin/pkgconf
CARGO_ENCODED_RUSTFLAGS="-Dwarnings"$'\x1f'"--remap-path-prefix=$release_vendor=/usr/src/fvca/vendor" \
cargo build --frozen --release --target "$target" --no-default-features --features appliance,workload \
    --bin fvca-workload-channel --manifest-path "$SRCDIR/release-client/Cargo.toml"
channel="$DESTDIR/usr/lib/fvca/workload-channel"
install -Dm755 "$CARGO_TARGET_DIR/$target/release/fvca-workload-channel" "$channel"
patchelf --add-needed "$allocator_library" "$channel"
dependencies=$(patchelf --print-needed "$channel")
test "${dependencies%%$'\n'*}" = "$allocator_library"
