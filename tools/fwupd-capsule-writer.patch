+#define FU_FVCA_DRAIN_RECEIPT "firmware-guest-drained"
+#define FU_FVCA_LEASE "guest-capture.lock"
+#define FU_FVCA_FILE_FLAGS (O_RDONLY | O_NOCTTY | O_NONBLOCK | O_CLOEXEC)
+#define FU_FVCA_DIR_FLAGS (O_RDONLY | O_NOFOLLOW | O_DIRECTORY | O_CLOEXEC)
+
+static gboolean
+fu_fvca_deny(GError **error, const gchar *message)
+{
+	g_set_error_literal(error, FWUPD_ERROR, FWUPD_ERROR_PERMISSION_DENIED, message);
+	return FALSE;
+}
+
+static gint
+fu_fvca_openat(gint parent, const gchar *name, guint64 flags)
+{
+	struct open_how how = {
+	    .flags = flags,
+	    .resolve = RESOLVE_BENEATH | RESOLVE_NO_XDEV | RESOLVE_NO_SYMLINKS,
+	};
+	return syscall(SYS_openat2, parent, name, &how, sizeof(how));
+}
+
+static gboolean
+fu_fvca_private(gint fd, mode_t mode, struct stat *st)
+{
+	return fstat(fd, st) == 0 && st->st_uid == 0 && st->st_gid == 0 &&
+	       (st->st_mode & (S_IFMT | 07777)) == mode &&
+	       (!S_ISREG(mode) || st->st_nlink == 1);
+}
+
+static GBytes *
+fu_fvca_record(gint parent,
+		const gchar *name,
+		mode_t mode,
+		gsize limit,
+		gboolean durable,
+		GError **error)
+{
+	g_autofd gint fd = fu_fvca_openat(parent, name, FU_FVCA_FILE_FLAGS);
+	struct stat st;
+	g_autofree guint8 *data = NULL;
+
+	if (fd < 0 || !fu_fvca_private(fd, S_IFREG | mode, &st) ||
+	    st.st_size <= 0 || (guint64)st.st_size > limit) {
+		fu_fvca_deny(error, "FVCA firmware record is missing, untrusted or outside its size bound");
+		return NULL;
+	}
+	data = g_malloc(st.st_size);
+	if (pread(fd, data, st.st_size, 0) != st.st_size) {
+		fu_fvca_deny(error, "FVCA could not read the entire firmware record");
+		return NULL;
+	}
+	if (durable && (fsync(fd) != 0 || fsync(parent) != 0)) {
+		fu_fvca_deny(error, "FVCA could not synchronize the firmware operation record");
+		return NULL;
+	}
+	return g_bytes_new_take(g_steal_pointer(&data), st.st_size);
+}
+
+static void
+fu_fvca_release_history(gpointer user_data)
+{
+	gint *fd = user_data;
+	close(*fd);
+	g_free(fd);
+}
+
+gboolean
+fu_fvca_lock_history(GObject *daemon, GError **error)
+{
+	g_autofd gint fd = -1;
+	struct stat st;
+	struct statfs fs;
+	gint *lease;
+
+	if (g_strcmp0(g_getenv("FVCA_FWUPD_PERSISTENT_HISTORY"), "1") != 0)
+		return TRUE;
+	fd = open(FU_FVCA_HISTORY, FU_FVCA_DIR_FLAGS);
+	if (fd < 0 || !fu_fvca_private(fd, S_IFDIR | 0700, &st) ||
+	    fstatfs(fd, &fs) != 0 || fs.f_type != BTRFS_SUPER_MAGIC ||
+	    flock(fd, LOCK_EX | LOCK_NB) != 0)
+		return fu_fvca_deny(error, "FVCA requires exclusive custody of Host firmware history");
+	lease = g_new(gint, 1);
+	*lease = g_steal_fd(&fd);
+	g_object_set_data_full(daemon, "fvca-history-lease", lease, fu_fvca_release_history);
+	return TRUE;
+}
+
+gboolean
+fu_fvca_capsule_writer_enabled(void)
+{
+	return g_strcmp0(g_getenv("FVCA_FWUPD_CAPSULE_WRITER"), "1") == 0;
+}
+
+gint
+fu_fvca_capsule_open_esp(gboolean writable, GError **error)
+{
+	g_autofd gint run = open(FU_FVCA_RUN, FU_FVCA_DIR_FLAGS);
+	g_autofd gint esp = -1;
+	g_autoptr(GBytes) binding = NULL;
+	guint64 device_id = 0;
+	struct stat st;
+	struct statfs fs;
+	struct statvfs flags;
+
+	if (run < 0)
+		goto invalid;
+	binding = fu_fvca_record(run, FU_FVCA_ESP_BINDING, 0600, 102, FALSE, error);
+	if (binding == NULL)
+		return -1;
+	/* Eight bytes for dev_t followed by the signed UKI EFI device path. */
+	if (g_bytes_get_size(binding) != 102)
+		goto invalid;
+	memcpy(&device_id, g_bytes_get_data(binding, NULL), sizeof(device_id));
+	esp = open(FU_FVCA_ESP, FU_FVCA_DIR_FLAGS);
+	if (esp < 0 || fstat(esp, &st) != 0 || st.st_dev != GUINT64_FROM_LE(device_id) ||
+	    fstatfs(esp, &fs) != 0 || fs.f_type != MSDOS_SUPER_MAGIC ||
+	    fstatvfs(esp, &flags) != 0 ||
+	    (flags.f_flag & (ST_NODEV | ST_NOSUID | ST_NOEXEC)) !=
+		    (ST_NODEV | ST_NOSUID | ST_NOEXEC) ||
+	    writable == ((flags.f_flag & ST_RDONLY) != 0))
+		goto invalid;
+	return g_steal_fd(&esp);
+invalid:
+	fu_fvca_deny(error, "FVCA requires the verified VFAT ESP with the expected access mode");
+	return -1;
+}
+
+gboolean
+fu_fvca_capsule_bind_esp(FuEngine *engine, GError **error)
+{
+	const gboolean writer = fu_fvca_capsule_writer_enabled();
+	g_autofd gint esp = -1;
+	g_autoptr(FuVolume) volume = NULL;
+	struct stat binding;
+
+	/* Unenrolled discovery can run without a Host ESP binding. */
+	if (!writer && lstat(FU_FVCA_RUN "/" FU_FVCA_ESP_BINDING, &binding) != 0 && errno == ENOENT)
+		return TRUE;
+	esp = fu_fvca_capsule_open_esp(writer, error);
+	if (esp < 0)
+		return FALSE;
+	volume = fu_volume_new_from_mount_path(FU_FVCA_ESP);
+	fu_volume_set_partition_kind(volume, FU_VOLUME_KIND_ESP);
+	fu_context_add_esp_volume(fu_engine_get_context(engine), volume);
+	return TRUE;
+}
+
+static FwupdJsonObject *
+fu_fvca_json(GBytes *bytes, GError **error)
+{
+	g_autoptr(FwupdJsonParser) parser = fwupd_json_parser_new();
+	g_autoptr(FwupdJsonNode) node = NULL;
+
+	fwupd_json_parser_set_max_depth(parser, 8);
+	fwupd_json_parser_set_max_items(parser, 256);
+	fwupd_json_parser_set_max_quoted(parser, 1024);
+	node = fwupd_json_parser_load_from_bytes(parser, bytes, FWUPD_JSON_LOAD_FLAG_NONE, error);
+	if (node == NULL)
+		return NULL;
+	return fwupd_json_node_get_object(node, error);
+}
+
+static gboolean
+fu_fvca_match(FwupdJsonObject *obj, const gchar *key, const gchar *expected)
+{
+	g_autoptr(GRefString) value = fwupd_json_object_get_string(obj, key, NULL);
+	return g_strcmp0(value, expected) == 0;
+}
+
+static gboolean
+fu_fvca_match_version(FwupdJsonObject *offer, const gchar *key, const gchar *text, guint32 raw)
+{
+	g_autoptr(FwupdJsonObject) version = fwupd_json_object_get_object(offer, key, NULL);
+	gint64 value = 0;
+
+	return version != NULL && fu_fvca_match(version, "text", text) &&
+	       fwupd_json_object_get_integer(version, "raw", &value, NULL) && value == raw;
+}
+
+static gboolean
+fu_fvca_match_catalog(FwupdJsonObject *offer, const gchar *catalog)
+{
+	g_autoptr(FwupdJsonObject) record = fwupd_json_object_get_object(offer, "catalog", NULL);
+	g_autoptr(FwupdJsonObject) metadata = NULL;
+	g_autoptr(FwupdJsonObject) signature = NULL;
+	g_autoptr(GRefString) metadata_sha = NULL;
+	g_autoptr(GRefString) signature_sha = NULL;
+	g_autofree gchar *suffix = NULL;
+	const gchar *separator = strchr(catalog, ':');
+
+	if (record == NULL || separator == NULL)
+		return FALSE;
+	metadata = fwupd_json_object_get_object(record, "metadata", NULL);
+	signature = fwupd_json_object_get_object(record, "signature", NULL);
+	if (metadata == NULL || signature == NULL)
+		return FALSE;
+	metadata_sha = fwupd_json_object_get_string(metadata, "sha256", NULL);
+	signature_sha = fwupd_json_object_get_string(signature, "sha256", NULL);
+	if (metadata_sha == NULL || signature_sha == NULL)
+		return FALSE;
+	suffix = g_strconcat(metadata_sha, ":", signature_sha, NULL);
+	return g_strcmp0(separator + 1, suffix) == 0;
+}
+
+static gboolean
+fu_fvca_match_offer(GBytes *body,
+		    const FuFvcaCabinet *identity,
+		    const gchar *offer_sha256,
+		    const gchar *catalog,
+		    GError **error)
+{
+	g_autofree gchar *digest = g_compute_checksum_for_bytes(G_CHECKSUM_SHA256, body);
+	g_autoptr(FwupdJsonObject) head = NULL;
+	g_autoptr(FwupdJsonObject) offer = NULL;
+	g_autoptr(FwupdJsonObject) device = NULL;
+	g_autoptr(FwupdJsonObject) archive = NULL;
+
+	if (g_strcmp0(digest, offer_sha256) != 0)
+		return fu_fvca_deny(error, "FVCA staged offer differs from the active operation digest");
+	head = fu_fvca_json(body, error);
+	if (head == NULL)
+		return FALSE;
+	offer = fwupd_json_object_get_object(head, "offer", error);
+	if (offer == NULL)
+		return FALSE;
+	device = fwupd_json_object_get_object(offer, "device", error);
+	if (device == NULL)
+		return FALSE;
+	archive = fwupd_json_object_get_object(offer, "archive", error);
+	if (archive == NULL)
+		return FALSE;
+	if (!fu_fvca_match(head, "schema", "fvca-firmware-channel-v1") ||
+	    !fu_fvca_match(head, "role", "hypervisor") ||
+	    !fu_fvca_match(head, "fwupd_version", VERSION) ||
+	    !fu_fvca_match(offer, "remote", "lvfs") ||
+	    !fu_fvca_match(device, "device_id", identity->device_id) ||
+	    !fu_fvca_match(device, "guid", identity->guid) ||
+	    (!fu_fvca_match(device, "component", "system-firmware") &&
+	     !fu_fvca_match(device, "component", "embedded-controller")) ||
+	    !fu_fvca_match(device, "version_format", identity->format) ||
+	    !fu_fvca_match_version(offer, "from", identity->from, identity->from_raw) ||
+	    !fu_fvca_match_version(offer, "to", identity->to, identity->to_raw) ||
+	    !fu_fvca_match(archive, "sha256", identity->archive_sha256) ||
+	    !fu_fvca_match(offer, "payload_sha256", identity->payload_sha256) ||
+	    !fu_fvca_match_catalog(offer, catalog))
+		return fu_fvca_deny(error, "FVCA cabinet or catalog differs from the exact staged offer");
+	return TRUE;
+}
+
+gboolean
+fu_fvca_capsule_authorize(gint lease,
+			  const FuFvcaCabinet *identity,
+			  const gchar *transaction,
+			  const gchar *offer_sha256,
+			  const gchar *catalog,
+			  GError **error)
+{
+	g_autofd gint run = open(FU_FVCA_RUN, FU_FVCA_DIR_FLAGS);
+	g_autofd gint lock = -1;
+	g_autofd gint pool = -1;
+	g_autofd gint directory = -1;
+	g_autoptr(GBytes) activation = NULL;
+	g_autoptr(GBytes) drained = NULL;
+	g_autoptr(GBytes) offer = NULL;
+	g_autoptr(FwupdJsonObject) record = NULL;
+	g_autofree gchar *boot_id = NULL;
+	g_autofree gchar *expected_drain = NULL;
+	g_autofree gchar *offer_path = NULL;
+	struct stat lock_stat;
+	struct stat lease_stat;
+	struct stat dir_stat;
+	struct statx run_mount;
+	struct statx pool_mount;
+	struct statfs fs;
+	gsize boot_id_size = 0;
+
+	if (run < 0)
+		return fu_fvca_deny(error, "FVCA firmware runtime directory is unavailable");
+	lock = fu_fvca_openat(run, FU_FVCA_LEASE, FU_FVCA_FILE_FLAGS);
+	if (lock < 0 || !fu_fvca_private(lock, S_IFREG | 0600, &lock_stat) ||
+	    !fu_fvca_private(lease, S_IFREG | 0600, &lease_stat) ||
+	    lock_stat.st_dev != lease_stat.st_dev || lock_stat.st_ino != lease_stat.st_ino ||
+	    flock(lock, LOCK_EX | LOCK_NB) == 0 || errno != EWOULDBLOCK ||
+	    flock(lease, LOCK_EX | LOCK_NB) != 0)
+		return fu_fvca_deny(error, "FVCA firmware writer requires the Host lifecycle lease");
+	pool = open(FU_FVCA_POOL, FU_FVCA_DIR_FLAGS);
+	if (pool < 0 || !fu_fvca_private(pool, S_IFDIR | 0700, &dir_stat) ||
+	    fstatfs(pool, &fs) != 0 || fs.f_type != BTRFS_SUPER_MAGIC ||
+	    statx(run, "", AT_EMPTY_PATH, STATX_MNT_ID, &run_mount) != 0 ||
+	    statx(pool, "", AT_EMPTY_PATH, STATX_MNT_ID, &pool_mount) != 0 ||
+	    (run_mount.stx_mask & pool_mount.stx_mask & STATX_MNT_ID) == 0 ||
+	    run_mount.stx_mnt_id == pool_mount.stx_mnt_id)
+		return fu_fvca_deny(error, "FVCA firmware activation requires the private Btrfs Host pool");
+	directory = fu_fvca_openat(pool, "firmware-update", FU_FVCA_DIR_FLAGS);
+	if (directory < 0 || !fu_fvca_private(directory, S_IFDIR | 0700, &dir_stat))
+		return fu_fvca_deny(error, "FVCA firmware activation directory is unavailable");
+	activation = fu_fvca_record(directory, "activation.json", 0600, 1024, TRUE, error);
+	if (activation == NULL)
+		return FALSE;
+	record = fu_fvca_json(activation, error);
+	if (record == NULL)
+		return FALSE;
+	if (!g_file_get_contents("/proc/sys/kernel/random/boot_id", &boot_id, &boot_id_size, error))
+		return FALSE;
+	if (boot_id_size != 37 || boot_id[36] != '\n')
+		return fu_fvca_deny(error, "FVCA firmware writer cannot determine the current boot");
+	boot_id[36] = '\0';
+	if (!g_uuid_string_is_valid(boot_id) ||
+	    !fu_fvca_match(record, "schema", "fvca-firmware-activation-v1") ||
+	    !fu_fvca_match(record, "phase", "flashing") ||
+	    !fu_fvca_match(record, "boot_id", boot_id) ||
+	    !fu_fvca_match(record, "transaction", transaction) ||
+	    !fu_fvca_match(record, "offer_sha256", offer_sha256) ||
+	    !fu_fvca_match(record, "device_id", identity->device_id))
+		return fu_fvca_deny(error, "FVCA firmware request differs from the durable flashing operation");
+
+	drained = fu_fvca_record(run, FU_FVCA_DRAIN_RECEIPT, 0600, 256, FALSE, error);
+	if (drained == NULL)
+		return FALSE;
+	expected_drain = g_strdup_printf("FVCA-FIRMWARE-DRAIN-1\nboot_id=%s\ntransaction=%s\noffer_sha256=%s\n",
+					 boot_id, transaction, offer_sha256);
+	if (g_bytes_get_size(drained) != strlen(expected_drain) ||
+	    memcmp(g_bytes_get_data(drained, NULL), expected_drain, strlen(expected_drain)) != 0)
+		return fu_fvca_deny(error, "FVCA firmware writer requires the matching Guest drain receipt");
+
+	offer_path = g_build_filename("staged", offer_sha256, "offer.json", NULL);
+	offer = fu_fvca_record(directory, offer_path, 0400, 64 * FU_KB, FALSE, error);
+	return offer != NULL && fu_fvca_match_offer(offer, identity, offer_sha256, catalog, error);
+}
+
+gboolean
+fu_fvca_capsule_install(FuEngine *engine, FuRelease *release, const gchar *operation, GError **error)
+{
+	FuEngineRequest *request = fu_release_get_request(release);
+	FuDevice *device = fu_release_get_device(release);
+	const gchar *id = fu_device_get_id(device);
+	g_autoptr(FuDevice) history = NULL;
+	g_autoptr(GError) error_history = NULL;
+	g_autoptr(GPtrArray) releases = g_ptr_array_new();
+	g_autoptr(FuProgress) progress = fu_progress_new(G_STRLOC);
+	FwupdRelease *previous;
+	g_autofd gint esp = -1;
+	g_autofd gint efivars = -1;
+	struct statfs fs;
+
+	if (g_strcmp0(G_OBJECT_TYPE_NAME(device), "FuUefiCodDevice") != 0 ||
+	    fu_device_has_private_flag(device, "no-rt-set-variable") ||
+	    fu_device_has_private_flag(device, "cod-dell-recovery"))
+		return fu_fvca_deny(error, "FVCA firmware writer requires a standard capsule-on-disk device");
+
+	history = fu_engine_get_fvca_history(engine, id, &error_history);
+	if (history == NULL) {
+		if (!g_error_matches(error_history, FWUPD_ERROR, FWUPD_ERROR_NOT_FOUND)) {
+			g_propagate_error(error, g_steal_pointer(&error_history));
+			return FALSE;
+		}
+	} else {
+		previous = fu_device_get_release_default(history);
+		if ((previous != NULL &&
+		     g_strcmp0(fu_release_get_metadata_item(FU_RELEASE(previous), "FvcaOperation"),
+			       operation) == 0) ||
+		    fu_device_get_update_state(history) == FWUPD_UPDATE_STATE_NEEDS_REBOOT ||
+		    fu_device_get_update_state(history) == FWUPD_UPDATE_STATE_PENDING)
+			return fu_fvca_deny(error, "FVCA firmware operation already has history or is pending");
+	}
+
+	esp = fu_fvca_capsule_open_esp(TRUE, error);
+	if (esp < 0)
+		return FALSE;
+	efivars = open("/sys/firmware/efi/efivars", FU_FVCA_DIR_FLAGS);
+	if (efivars < 0 || fstatfs(efivars, &fs) != 0 || fs.f_type != EFIVARFS_MAGIC ||
+	    (fs.f_flags & ST_RDONLY) != 0 || fs.f_bsize != 1 ||
+	    fs.f_bavail < 256 || fs.f_bfree < fs.f_bavail || fs.f_bfree - fs.f_bavail < 5 * 1024)
+		return fu_fvca_deny(error, "FVCA requires the writable EFI variable store and its capacity reserve");
+	fu_release_add_metadata_item(release, "FvcaOperation", operation);
+	g_ptr_array_add(releases, release);
+	if (!fu_engine_install_releases(engine, request, releases, progress, FWUPD_INSTALL_FLAG_NONE, error))
+		return FALSE;
+	g_clear_object(&history);
+	history = fu_engine_get_fvca_history(engine, id, error);
+	if (history == NULL)
+		return FALSE;
+	previous = fu_device_get_release_default(history);
+	if (previous == NULL ||
+	    g_strcmp0(fu_release_get_metadata_item(FU_RELEASE(previous), "FvcaOperation"), operation) != 0 ||
+	    fu_device_get_update_state(history) != FWUPD_UPDATE_STATE_NEEDS_REBOOT)
+		return fu_fvca_deny(error, "FVCA could not verify the pending native capsule result");
+	return TRUE;
+}
