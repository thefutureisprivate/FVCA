+static gboolean
+fu_uefi_cod_device_require_idle_efi(FuEfivars *efivars, GError **error)
+{
+	const FuEfiVariableAttrs required =
+	    FU_EFI_VARIABLE_ATTR_NON_VOLATILE | FU_EFI_VARIABLE_ATTR_BOOTSERVICE_ACCESS |
+	    FU_EFI_VARIABLE_ATTR_RUNTIME_ACCESS;
+	FuEfiVariableAttrs attributes = 0;
+	g_autoptr(GError) local_error = NULL;
+	g_autoptr(GBytes) data = NULL;
+	guint64 indications = 0;
+
+	data = fu_efivars_get_data_bytes(efivars, FU_EFIVARS_GUID_EFI_GLOBAL, "BootNext",
+					NULL, &local_error);
+	if (data != NULL) {
+		g_set_error_literal(error, FWUPD_ERROR, FWUPD_ERROR_NOT_SUPPORTED,
+				    "FVCA cannot stage a capsule with BootNext pending");
+		return FALSE;
+	}
+	if (!g_error_matches(local_error, FWUPD_ERROR, FWUPD_ERROR_NOT_FOUND)) {
+		g_propagate_error(error, g_steal_pointer(&local_error));
+		return FALSE;
+	}
+	g_clear_error(&local_error);
+	data = fu_efivars_get_data_bytes(efivars, FU_EFIVARS_GUID_EFI_GLOBAL, "OsIndications",
+					&attributes, &local_error);
+	if (data == NULL) {
+		if (g_error_matches(local_error, FWUPD_ERROR, FWUPD_ERROR_NOT_FOUND))
+			return TRUE;
+		g_propagate_error(error, g_steal_pointer(&local_error));
+		return FALSE;
+	}
+	if (attributes != required || g_bytes_get_size(data) != sizeof(indications) ||
+	    memcmp(g_bytes_get_data(data, NULL), &indications, sizeof(indications)) != 0) {
+		g_set_error_literal(error, FWUPD_ERROR, FWUPD_ERROR_NOT_SUPPORTED,
+				    "FVCA requires a clear EFI OsIndications mask");
+		return FALSE;
+	}
+	return TRUE;
+}
+
+static gboolean
+fu_uefi_cod_device_require_empty_queue(gint esp, GError **error)
+{
+	struct open_how how = {
+	    .flags = O_RDONLY | O_DIRECTORY | O_CLOEXEC,
+	    .resolve = RESOLVE_BENEATH | RESOLVE_NO_XDEV | RESOLVE_NO_SYMLINKS,
+	};
+	g_autofd gint efi = syscall(SYS_openat2, esp, "EFI", &how, sizeof(how));
+	g_autofd gint queue = -1;
+	DIR *directory;
+	struct dirent *entry;
+
+	if (efi < 0)
+		goto unreadable;
+	queue = syscall(SYS_openat2, efi, "UpdateCapsule", &how, sizeof(how));
+	if (queue < 0 && errno == ENOENT)
+		return TRUE;
+	if (queue < 0)
+		goto unreadable;
+	directory = fdopendir(queue);
+	if (directory == NULL)
+		goto unreadable;
+	(void)g_steal_fd(&queue);
+	errno = 0;
+	while ((entry = readdir(directory)) != NULL) {
+		if (g_strcmp0(entry->d_name, ".") != 0 && g_strcmp0(entry->d_name, "..") != 0) {
+			closedir(directory);
+			g_set_error_literal(error, FWUPD_ERROR, FWUPD_ERROR_NOT_SUPPORTED,
+					    "FVCA ESP already contains a queued capsule or foreign entry");
+			return FALSE;
+		}
+	}
+	if (errno != 0) {
+		closedir(directory);
+		goto unreadable;
+	}
+	closedir(directory);
+	return TRUE;
+unreadable:
+	g_set_error_literal(error, FWUPD_ERROR, FWUPD_ERROR_INVALID_FILE,
+			    "FVCA could not verify the capsule directory on the bound ESP");
+	return FALSE;
+}
