[Unit]
Description=FVCA Host firmware inventory
BindsTo=fvca-firmware-bus.service
After=fvca-firmware-bus.service
ConditionVirtualization=!container

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/libexec/fwupd/fwupd
Environment=DBUS_SYSTEM_BUS_ADDRESS=unix:path=/run/fvca/firmware-bus
TimeoutStartSec=60s
RuntimeDirectory=fvca-firmware
RuntimeDirectoryMode=0700
Environment=STATE_DIRECTORY=/run/fvca-firmware CACHE_DIRECTORY=/run/fvca-firmware
Environment=FVCA_FWUPD_PERSISTENT_HISTORY=0
Environment=FVCA_FWUPD_CAPSULE_WRITER=0
UnsetEnvironment=FWUPD_SELF_TEST
UMask=0077
CapabilityBoundingSet=
DevicePolicy=closed
DeviceAllow=char-nvme r
InaccessiblePaths=-/run/dbus -/run/systemd/private
LockPersonality=yes
MemoryDenyWriteExecute=yes
NoExecPaths=/run /tmp /var
NoNewPrivileges=yes
PrivateNetwork=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
