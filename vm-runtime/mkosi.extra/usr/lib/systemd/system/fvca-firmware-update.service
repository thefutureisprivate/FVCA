[Unit]
Description=Discover and stage qualified Host firmware
Wants=fvca-fwupd.service
After=fvca-base-ready.service fvca-fwupd.service
AssertSecurity=uefi-secureboot
AssertSecurity=selinux
AssertPathIsMountPoint=/run/fvca/host-data
ConditionPathExists=/run/fvca/firmware-update-owner
ConditionPathExists=!/run/fvca/boot-trial-started
StartLimitIntervalSec=90min
StartLimitBurst=3

[Service]
Type=oneshot
SELinuxContext=system_u:system_r:init_t:s0
ExecStart=/usr/libexec/fvca/release-client --run-firmware-update
TimeoutStartSec=20min
Restart=on-failure
RestartSec=5min
UMask=0077
CapabilityBoundingSet=
InaccessiblePaths=-/run/dbus -/run/systemd/private
MemoryDenyWriteExecute=yes
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=disconnected
ProtectControlGroups=yes
ProtectHome=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadWritePaths=/run/fvca/host-data
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
StandardOutput=journal+console
StandardError=journal+console
