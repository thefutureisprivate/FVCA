[Unit]
Description=Apply the authorized expiry policy to FVCA capture %i
AssertPathExists=/run/fvca/vm-retention-policy
AssertPathIsMountPoint=/run/fvca/host-data
AssertSecurity=selinux
AssertSecurity=uefi-secureboot

[Service]
Type=oneshot
SELinuxContext=system_u:system_r:init_t:s0
ExecStart=/usr/libexec/fvca/launch-guest --capture-expire %i
TimeoutStartSec=2min
UMask=0077
NoNewPrivileges=yes
MemoryDenyWriteExecute=yes
StandardOutput=journal+console
StandardError=journal+console
