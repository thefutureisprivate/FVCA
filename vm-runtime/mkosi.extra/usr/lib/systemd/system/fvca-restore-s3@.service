[Unit]
Description=Cold-restore the registered FVCA Service Guest from authorized S3 recovery set %i
Requires=fvca-virtqemud.service
After=fvca-virtqemud.service
AssertPathExists=/run/fvca/vm-restore-authorization
AssertPathExists=/run/fvca/guest-launch
AssertSecurity=selinux
AssertSecurity=uefi-secureboot

[Service]
Type=oneshot
SELinuxContext=system_u:system_r:init_t:s0
ExecStart=/usr/libexec/fvca/launch-guest --restore-s3 %i
TimeoutStartSec=14h
UMask=0077
NoNewPrivileges=yes
MemoryDenyWriteExecute=yes
StandardOutput=journal+console
StandardError=journal+console
