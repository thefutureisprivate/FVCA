[Unit]
Description=FVCA Hypervisor boot quote collector
After=fvca-base-ready.service
AssertSecurity=uefi-secureboot
AssertSecurity=selinux
CollectMode=inactive-or-failed

[Service]
Type=oneshot
SELinuxContext=system_u:system_r:fvca_attestation_t:s0
ExecStart=/usr/libexec/fvca/release-client --serve-boot-quote
TimeoutStartSec=5s
TimeoutStopSec=1s
CapabilityBoundingSet=
DevicePolicy=closed
DeviceAllow=/dev/tpmrm0 rw
InaccessiblePaths=/run/fvca -/run/credentials -/run/dbus -/run/systemd/private -/run/libvirt
PrivateNetwork=yes
PrivateTmp=disconnected
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
NoNewPrivileges=yes
MemoryDenyWriteExecute=yes
NoExecPaths=/run /tmp /var
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
TasksMax=2
UMask=0077
