[Unit]
Description=Cold-restore the registered FVCA Service Guest from %i
Requires=fvca-virtqemud.service
After=fvca-virtqemud.service
AssertPathExists=/run/fvca/guest-launch
AssertSecurity=selinux
AssertSecurity=uefi-secureboot

[Service]
Type=oneshot
SELinuxContext=system_u:system_r:init_t:s0
ExecStart=/usr/libexec/fvca/launch-guest --restore %i
TimeoutStartSec=1h
UMask=0077
NoNewPrivileges=yes
MemoryDenyWriteExecute=yes
StandardOutput=journal+console
StandardError=journal+console
