[Unit]
Description=Upload and verify the sealed FVCA capture %i
AssertPathExists=/run/fvca/vm-backup-policy
AssertSecurity=selinux
AssertSecurity=uefi-secureboot

[Service]
Type=oneshot
Slice=fvca-backup.slice
ExecStart=/usr/libexec/fvca/backup-worker %i
TimeoutStartSec=13h
TimeoutStopSec=10s
DynamicUser=yes
SELinuxContext=system_u:system_r:fvca_backup_t:s0
NoNewPrivileges=yes
CapabilityBoundingSet=
MemoryDenyWriteExecute=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictSUIDSGID=yes
SystemCallFilter=~@mount @module @raw-io @reboot @swap
IPAddressDeny=any
TemporaryFileSystem=/run:ro
TemporaryFileSystem=/run/fvca-backup/tmp:rw,nosuid,nodev,noexec,size=256M,mode=1777,context=system_u:object_r:fvca_backup_tmp_t:s0
InaccessiblePaths=/var
BindReadOnlyPaths=/run/fvca/host-data/captures/outgoing/%i/input:/run/fvca-backup/input
BindReadOnlyPaths=/run/fvca/vm-backup-policy:/run/fvca-backup/policy
BindReadOnlyPaths=/run/fvca/vm-backup-ca.pem:/run/fvca-backup/ca.pem
LoadCredential=repository-password:/run/fvca/host-data/backup-credentials/repository-password
LoadCredential=s3-credentials:/run/fvca/host-data/backup-credentials/s3-credentials
UMask=0077
StandardOutput=truncate:/run/fvca/host-data/captures/outgoing/%i/result
StandardError=journal+console
