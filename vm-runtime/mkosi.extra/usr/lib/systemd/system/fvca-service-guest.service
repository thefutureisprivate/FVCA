[Unit]
Description=Launch the authorized FVCA Service Guest
Requires=fvca-vm-runtime-probe.service fvca-virtqemud.service
After=fvca-vm-runtime-probe.service fvca-virtqemud.service fvca-virtlogd.service fvca-virtlockd.service
Before=fvca-base-ready.service
AssertPathExists=/run/fvca/guest-launch
AssertSecurity=uefi-secureboot
AssertSecurity=selinux
OnFailure=emergency.target

[Service]
Type=oneshot
SELinuxContext=system_u:system_r:init_t:s0
RemainAfterExit=yes
ExecStart=/usr/libexec/fvca/launch-guest
ExecStop=/usr/libexec/fvca/launch-guest --shutdown
ExecStopPost=/usr/libexec/fvca/launch-guest --release
TimeoutStartSec=95s
TimeoutStopSec=35s
NoNewPrivileges=yes
MemoryDenyWriteExecute=yes
StandardOutput=journal+console
StandardError=journal+console
