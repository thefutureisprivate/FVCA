[Unit]
Description=FVCA Hypervisor firmware observer
After=fvca-base-ready.service
AssertPathIsMountPoint=/run/fvca/host-data
AssertSecurity=uefi-secureboot
AssertSecurity=selinux
CollectMode=inactive-or-failed

[Service]
Type=oneshot
SELinuxContext=system_u:system_r:fvca_firmware_observer_t:s0
ExecStart=/usr/libexec/fvca/release-client --serve-firmware-status
TimeoutStartSec=2s
CapabilityBoundingSet=
InaccessiblePaths=-/run/credentials -/run/dbus -/run/systemd/private -/run/libvirt -/run/fvca-firmware-bus -/run/fvca/firmware-bus-writer
ReadOnlyPaths=/run/fvca
PrivateDevices=yes
PrivateNetwork=yes
PrivateTmp=disconnected
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
NoNewPrivileges=yes
MemoryDenyWriteExecute=yes
NoExecPaths=/run /tmp /var
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
TasksMax=2
UMask=0077
