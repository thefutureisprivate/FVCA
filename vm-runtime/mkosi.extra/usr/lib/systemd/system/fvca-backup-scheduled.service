[Unit]
Description=Run the authorized FVCA Service Guest backup job
Requires=fvca-virtqemud.service
After=fvca-base-ready.service fvca-virtqemud.service
AssertPathExists=/run/fvca/vm-backup-job
AssertPathExists=/run/fvca/guest-launch
AssertPathIsMountPoint=/run/fvca/host-data
AssertSecurity=selinux
AssertSecurity=uefi-secureboot

[Service]
Type=oneshot
SELinuxContext=system_u:system_r:init_t:s0
ExecStart=/usr/libexec/fvca/launch-guest --backup-job-run
TimeoutStartSec=14h
UMask=0077
NoNewPrivileges=yes
MemoryDenyWriteExecute=yes
StandardOutput=journal+console
StandardError=journal+console
