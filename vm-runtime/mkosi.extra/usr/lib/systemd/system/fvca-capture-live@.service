[Unit]
Description=Capture the running FVCA Service Guest as %i
Requires=fvca-virtqemud.service
After=fvca-virtqemud.service
AssertPathExists=/run/fvca/guest-launch
AssertSecurity=selinux
AssertSecurity=uefi-secureboot

[Service]
Type=oneshot
SELinuxContext=system_u:system_r:init_t:s0
ExecStart=/usr/libexec/fvca/launch-guest --capture-live %i
ExecStopPost=/usr/bin/systemctl start fvca-live-recover@%i.service
TimeoutStartSec=1h
TimeoutStopSec=45s
NoNewPrivileges=yes
MemoryDenyWriteExecute=yes
StandardOutput=journal+console
StandardError=journal+console
