[Unit]
Description=Reconcile the pending Host firmware activation
Wants=fvca-fwupd.service
After=fvca-base-ready.service fvca-fwupd.service
AssertSecurity=uefi-secureboot
AssertSecurity=selinux
AssertPathIsMountPoint=/run/fvca/host-data
AssertPathExists=/run/fvca/firmware-update-owner
ConditionPathExists=!/run/fvca/boot-trial-started

[Service]
Type=oneshot
SELinuxContext=system_u:system_r:init_t:s0
ExecStart=/usr/libexec/fvca/release-client --reconcile-firmware-update
TimeoutStartSec=2min
Restart=on-failure
RestartSec=5min
UMask=0077
CapabilityBoundingSet=
InaccessiblePaths=-/run/dbus
MemoryDenyWriteExecute=yes
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=disconnected
ProtectControlGroups=yes
ProtectHome=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadWritePaths=/run/fvca/host-data /run/fvca/firmware-activation
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
StandardOutput=journal+console
StandardError=journal+console
