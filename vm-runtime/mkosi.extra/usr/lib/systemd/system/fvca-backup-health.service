[Unit]
Description=Check freshness and dispatch the authorized FVCA backup job
After=fvca-base-ready.service
AssertPathExists=/run/fvca/vm-backup-job
AssertPathIsMountPoint=/run/fvca/host-data
AssertSecurity=selinux
AssertSecurity=uefi-secureboot

[Service]
Type=oneshot
SELinuxContext=system_u:system_r:init_t:s0
ExecStart=/usr/libexec/fvca/launch-guest --backup-job-health
TimeoutStartSec=30s
UMask=0077
NoNewPrivileges=yes
MemoryDenyWriteExecute=yes
StandardOutput=journal+console
StandardError=journal+console
