; The upload process receives a read-only bind of the staged capture, private
; systemd credentials, and pre-opened result and diagnostic descriptors.
(type fvca_backup_t)
(type fvca_backup_result_t)
(typeattributeset file_type (fvca_backup_result_t))
(roletype object_r fvca_backup_result_t)
(allow fvca_backup_result_t fs_t (filesystem (associate)))
(allow init_t fvca_backup_result_t (file (getattr open read relabelto unlink write)))
(typeattributeset domain (fvca_backup_t))
(typeattributeset daemon (fvca_backup_t))
(roletype system_r fvca_backup_t)
(allow init_t fvca_backup_t (process (getattr sigkill signal sigstop transition)))
(allow init_t fvca_backup_t (process2 (nnp_transition)))
(allow fvca_backup_t init_t (process (sigchld)))
(allow fvca_backup_t init_t (fd (use)))
(allow fvca_backup_t init_t (unix_stream_socket (getattr read write)))
(allow fvca_backup_t syslogd_t (unix_stream_socket (getattr write)))
(allow fvca_backup_t self (process (fork getcap getpgid sigchld signal)))
(allow fvca_backup_t self (fifo_file (getattr ioctl read write)))

; Both executables and the allocator are supplied by the verified role image.
(allow fvca_backup_t bin_t (file (entrypoint execute execute_no_trans getattr map open read)))
(allow fvca_backup_t bin_t (dir (getattr search)))
(allow fvca_backup_t usr_t (dir (getattr open read search)))
(allow fvca_backup_t lib_t (dir (getattr open read search)))
(allow fvca_backup_t lib_t (file (execute getattr map open read)))
(allow fvca_backup_t ld_so_t (file (execute getattr map open read)))
(allow fvca_backup_t ld_so_cache_t (file (getattr map open read)))
(allow fvca_backup_t etc_t (dir (getattr search)))
(allow fvca_backup_t etc_t (file (getattr map open read)))
(allow fvca_backup_t etc_t (lnk_file (getattr read)))
(allow fvca_backup_t locale_t (dir (getattr search)))
(allow fvca_backup_t locale_t (file (getattr open read)))
(allow fvca_backup_t root_t (dir (getattr search)))
(allow fvca_backup_t device_t (dir (getattr search)))
(allow fvca_backup_t null_device_t (chr_file (getattr open read write)))
(allow fvca_backup_t urandom_device_t (chr_file (getattr open read)))
(allow fvca_backup_t proc_t (dir (getattr search)))
(allow fvca_backup_t proc_t (file (getattr open read)))

(allow fvca_backup_t var_run_t (dir (getattr search)))
(allow fvca_backup_t var_run_t (file (getattr open read)))
(allow fvca_backup_t init_var_run_t (dir (getattr search)))
(allow fvca_backup_t init_var_run_t (file (getattr open read)))
(allow fvca_backup_t tmpfs_t (dir (getattr search)))
(allow fvca_backup_t tmpfs_t (file (getattr open read)))
(allow fvca_backup_t fvca_host_data_t (dir (getattr open read search)))
(allow fvca_backup_t fvca_host_data_t (file (getattr open read)))
(allow fvca_backup_t fvca_backup_result_t (file (getattr write)))

; The downloader writes only pre-created regular staging members. The
; coordinator owns their directories and creates the independent VM slot.
(type fvca_restore_data_t)
(typeattributeset file_type (fvca_restore_data_t))
(roletype object_r fvca_restore_data_t)
(allow fvca_restore_data_t fs_t (filesystem (associate)))
(allow init_t fvca_host_data_t (dir (rmdir)))
(allow init_t fvca_restore_data_t (file (getattr ioctl open read relabelto setattr unlink write)))
(allow fvca_backup_t fvca_restore_data_t (file (getattr open read setattr write)))

; Encrypted restic packs use only the worker's private, size-capped tmpfs.
(type fvca_backup_tmp_t)
(typeattributeset file_type (fvca_backup_tmp_t))
(roletype object_r fvca_backup_tmp_t)
(allow init_t tmpfs_t (filesystem (relabelfrom)))
(allow init_t fvca_backup_tmp_t (filesystem (getattr mount relabelfrom relabelto remount unmount)))
(allow fvca_backup_tmp_t tmpfs_t (filesystem (associate)))
(allow fvca_backup_tmp_t self (filesystem (associate)))
(allow fvca_backup_t fvca_backup_tmp_t (dir (add_name getattr remove_name search write)))
(allow fvca_backup_t fvca_backup_tmp_t (file (create getattr open read setattr unlink write)))

; systemd's signed egress policy admits the selected address. The worker
; always uses the selected TLS port and supplies no name-service requests.
(allow fvca_backup_t self (tcp_socket (connect create getattr getopt ioctl read setopt shutdown write)))
(allow fvca_backup_t port_type (tcp_socket (name_connect)))
