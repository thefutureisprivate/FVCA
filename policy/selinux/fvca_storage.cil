; Unseal the explicitly selected LUKS2 token in the confined cryptsetup domain.
(allow lvm_t tpm_device_t (chr_file (getattr open read write ioctl)))

; Use a confined default on the verified Host pool. Existing file xattrs,
; including the dynamic sVirt label on the bound raw disk, retain their effect.
(type fvca_host_data_t)
(typeattributeset file_type (fvca_host_data_t))
(roletype object_r fvca_host_data_t)
(allow init_t fs_t (filesystem (relabelfrom)))
(allow fvca_host_data_t fs_t (filesystem (associate)))
(allow init_t fvca_host_data_t (dir (add_name create getattr ioctl open read remove_name search setattr write)))
(allow init_t fvca_host_data_t (file (create getattr ioctl lock open read relabelfrom relabelto rename setattr unlink write)))
(allow init_t virt_image_t (file (relabelfrom relabelto)))
; Let the firmware daemon traverse to its separately labeled history directory.
(allow fwupd_t fvca_host_data_t (dir (getattr search)))

; Firmware policy, staged offers and activation records have a separate scope
; on the Host pool. Only fwupd's own history has a writable daemon label.
(type fvca_firmware_state_t)
(typeattributeset file_type (fvca_firmware_state_t))
(roletype object_r fvca_firmware_state_t)
(allow fvca_firmware_state_t fs_t (filesystem (associate)))
(allow init_t fvca_firmware_state_t (dir (add_name create getattr open read relabelfrom relabelto remove_name rename reparent rmdir search setattr write)))
(allow init_t fvca_firmware_state_t (file (create getattr lock open read relabelfrom relabelto rename setattr unlink write)))
(allow fwupd_t fvca_firmware_state_t (dir (getattr open search)))
(allow fwupd_t fvca_firmware_state_t (file (getattr open read)))
(allow init_t fvca_os_stage_t (file (relabelfrom)))
(allow fwupd_t fvca_os_stage_t (dir (getattr search)))

; Cold restore moves two recorded VM subvolume roots between private parents.
; The launcher gives only those roots a movable label before the exchange.
(type fvca_vm_slot_t)
(typeattributeset file_type (fvca_vm_slot_t))
(roletype object_r fvca_vm_slot_t)
(allow fvca_vm_slot_t fs_t (filesystem (associate)))
(allow init_t fvca_host_data_t (dir (relabelfrom)))
(allow init_t fvca_vm_slot_t (dir (getattr ioctl open read relabelfrom relabelto rename reparent rmdir search write)))
(allowx init_t fvca_vm_slot_t (ioctl dir (0x9411 0x943c)))

; Publish release directories atomically inside the updater's staging area.
; Only the staging root receives this label during verified boot.
(type fvca_os_stage_t)
(typeattributeset file_type (fvca_os_stage_t))
(roletype object_r fvca_os_stage_t)
(allow fvca_os_stage_t fs_t (filesystem (associate)))
(allow init_t fvca_os_stage_t (dir (add_name create getattr open read relabelfrom relabelto remove_name rename rmdir search setattr write)))
(allow init_t fvca_os_stage_t (file (create getattr lock open read rename setattr unlink write)))
