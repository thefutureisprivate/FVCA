; The gateway receives the enrolled TCP socket and uses only the broker IPC.
; The broker writes typed configuration intents and delegates boot quotes.
(type fvca_management_gateway_t)
(type fvca_management_broker_t)
(type fvca_attestation_t)
(type fvca_firmware_observer_t)
(typeattribute fvca_management_domain)
(typeattributeset fvca_management_domain (fvca_management_gateway_t fvca_management_broker_t fvca_attestation_t fvca_firmware_observer_t))
(typeattributeset domain (fvca_management_domain))
(roletype system_r fvca_management_gateway_t)
(roletype system_r fvca_management_broker_t)
(roletype system_r fvca_attestation_t)
(roletype system_r fvca_firmware_observer_t)

(allow init_t fvca_management_domain (process (getattr sigkill signal transition)))
(allow init_t fvca_management_domain (process2 (nnp_transition)))
(allow init_t fvca_management_gateway_t (tcp_socket (bind create getattr getopt ioctl listen read setopt shutdown write)))
(allow init_t fvca_management_broker_t (unix_stream_socket (bind create getattr getopt ioctl listen read setopt shutdown write)))
; Linux checks the labeled socket against the signed port and address that PID 1 binds.
; The gateway process has neither create nor bind on TCP sockets.
(allow fvca_management_gateway_t port_type (tcp_socket (name_bind)))
(allow fvca_management_gateway_t node_type (tcp_socket (node_bind)))
(allow fvca_management_domain init_t (process (sigchld)))
(allow fvca_management_domain init_t (fd (use)))
(allow fvca_management_domain init_t (unix_stream_socket (getattr getopt ioctl read write)))
(allow fvca_management_domain syslogd_t (unix_stream_socket (getattr write)))
(allow fvca_management_domain self (process (getattr getcap)))
(allow fvca_management_domain self (file (getattr open read)))

; systemd selects the domain for the verified release-client entrypoint.
; No service domain has execute_no_trans on command binaries.
(allow fvca_management_domain bin_t (file (entrypoint execute getattr map open read)))
(allow fvca_management_domain bin_t (dir (getattr search)))
(allow fvca_management_domain usr_t (dir (getattr search)))
(allow fvca_management_domain lib_t (dir (getattr search)))
(allow fvca_management_domain lib_t (file (execute getattr map open read)))
(allow fvca_management_domain ld_so_t (file (execute getattr map open read)))
(allow fvca_management_domain ld_so_cache_t (file (getattr map open read)))
(allow fvca_management_domain etc_t (dir (getattr search)))
(allow fvca_management_domain etc_t (file (getattr open read)))
(allow fvca_management_domain etc_t (lnk_file (getattr read)))
(allow fvca_management_domain root_t (dir (getattr search)))
(allow fvca_management_domain device_t (dir (getattr search)))
(allow fvca_management_domain null_device_t (chr_file (getattr open read write)))
(allow fvca_management_domain urandom_device_t (chr_file (getattr open read)))
(allow fvca_management_domain proc_t (dir (getattr search)))
(allow fvca_management_domain proc_t (file (getattr open read)))
(allow fvca_management_domain proc_t (lnk_file (getattr read)))
(allow fvca_management_domain sysfs_t (dir (getattr search)))
(allow fvca_management_domain security_t (dir (getattr search)))
(allow fvca_management_domain security_t (file (getattr open read)))
(allow fvca_management_domain var_run_t (dir (getattr search)))
(allow fvca_management_domain tmpfs_t (dir (getattr search)))
(allow fvca_management_domain init_var_run_t (dir (getattr search)))

(type fvca_management_enrollment_t)
(typeattributeset file_type (fvca_management_enrollment_t))
(roletype object_r fvca_management_enrollment_t)
(filecon "/run/fvca/management\.json" file (system_u object_r fvca_management_enrollment_t ((s0) (s0))))
(allow fvca_management_enrollment_t fs_t (filesystem (associate)))
(allow fvca_management_enrollment_t tmpfs_t (filesystem (associate)))
(allow init_t fvca_management_enrollment_t (file (getattr open read relabelto)))
(allow fvca_management_gateway_t fvca_management_enrollment_t (file (getattr open read)))
(allow fvca_management_broker_t fvca_management_enrollment_t (file (getattr open read)))

(type fvca_management_socket_t)
(typeattributeset file_type (fvca_management_socket_t))
(roletype object_r fvca_management_socket_t)
(filecon "/run/fvca-management-broker" dir (system_u object_r fvca_management_socket_t ((s0) (s0))))
(filecon "/run/fvca-management-broker/broker\.sock" socket (system_u object_r fvca_management_socket_t ((s0) (s0))))
(allow fvca_management_socket_t tmpfs_t (filesystem (associate)))
(allow init_t fvca_management_socket_t (dir (add_name create getattr open read remove_name rmdir search setattr write)))
(allow init_t var_run_t (sock_file (relabelfrom)))
(allow init_t fvca_management_socket_t (sock_file (create getattr relabelto setattr unlink write)))
(allow fvca_management_gateway_t fvca_management_socket_t (dir (getattr search)))
(allow fvca_management_gateway_t fvca_management_socket_t (sock_file (getattr write)))
(allow fvca_management_gateway_t fvca_management_broker_t (unix_stream_socket (connectto)))
(allow fvca_management_gateway_t self (unix_stream_socket (connect create getattr getopt ioctl read setopt shutdown write)))
(allow fvca_management_gateway_t self (tcp_socket (accept getattr getopt ioctl read setopt shutdown write)))
(allow fvca_management_broker_t self (unix_stream_socket (accept connect create getattr getopt ioctl read setopt shutdown write)))
; Credentials are copied by PID 1 into the gateway's private read-only mount.
(allow fvca_management_gateway_t tmpfs_t (file (getattr open read)))
(allow fvca_management_gateway_t var_run_t (file (getattr open read)))
(allow fvca_management_gateway_t init_var_run_t (file (getattr open read)))

; A separate observer can read firmware records on the authenticated pool.
; Its only IPC is the accepting socket handed over by PID 1.
(type fvca_firmware_status_socket_t)
(typeattributeset file_type (fvca_firmware_status_socket_t))
(roletype object_r fvca_firmware_status_socket_t)
(filecon "/run/fvca-firmware-status" dir (system_u object_r fvca_firmware_status_socket_t ((s0) (s0))))
(filecon "/run/fvca-firmware-status/status\.sock" socket (system_u object_r fvca_firmware_status_socket_t ((s0) (s0))))
(allow fvca_firmware_status_socket_t tmpfs_t (filesystem (associate)))
(allow init_t fvca_firmware_status_socket_t (dir (add_name create getattr open read remove_name rmdir search setattr write)))
(allow init_t fvca_firmware_status_socket_t (sock_file (create getattr relabelto setattr unlink write)))
(allow init_t fvca_firmware_observer_t (unix_stream_socket (accept bind create getattr getopt listen read setopt shutdown write)))
(allow fvca_management_broker_t fvca_firmware_status_socket_t (dir (getattr search)))
(allow fvca_management_broker_t fvca_firmware_status_socket_t (sock_file (getattr write)))
(allow fvca_management_broker_t fvca_firmware_observer_t (unix_stream_socket (connectto)))
(allow fvca_firmware_observer_t self (unix_stream_socket (getattr getopt setopt write)))
(allow fvca_firmware_observer_t fs_t (filesystem (getattr)))
(allow fvca_firmware_observer_t fvca_host_data_t (dir (getattr open read search)))
(allow fvca_firmware_observer_t fvca_firmware_state_t (dir (getattr open read search)))
(allow fvca_firmware_observer_t fvca_firmware_state_t (file (getattr open read)))
(allow fvca_firmware_observer_t tmpfs_t (file (getattr open read)))
(allow fvca_firmware_observer_t var_run_t (file (getattr open read)))
(allow fvca_firmware_observer_t init_var_run_t (file (getattr open read)))

; The broker's mount namespace hides this one Host credential directory.
(type fvca_management_credentials_t)
(typeattributeset file_type (fvca_management_credentials_t))
(roletype object_r fvca_management_credentials_t)
(allow fvca_management_credentials_t fs_t (filesystem (associate)))
(allow init_t fvca_management_credentials_t (dir (getattr mounton open read relabelfrom relabelto search)))

(allow fvca_management_broker_t tmpfs_t (file (getattr lock open read)))
(allow fvca_management_broker_t var_run_t (file (getattr lock open read)))
(allow fvca_management_broker_t init_var_run_t (file (getattr lock open read)))
(optional fvca_management_firmware_lock
    (allow fvca_management_broker_t fvca_firmware_boot_input_t (file (getattr lock open read))))
(allow fvca_management_broker_t fs_t (filesystem (getattr)))
(allow fvca_management_broker_t efivarfs_t (dir (search)))
(allow fvca_management_broker_t efivarfs_t (file (getattr)))
(allow fvca_management_broker_t fvca_firmware_state_t (dir (search)))
(allow fvca_management_broker_t fvca_firmware_state_t (file (getattr)))
(allow fvca_management_broker_t fvca_host_data_t (dir (getattr open read search)))
(allow fvca_management_broker_t fvca_host_data_t (file (getattr open read)))
; Filesystem, space, subvolume and device information, and read-only device statistics.
; The broker has no CAP_SYS_ADMIN to reset device statistics.
(allow fvca_management_broker_t fvca_host_data_t (dir (ioctl)))
(allowx fvca_management_broker_t fvca_host_data_t (ioctl dir (0x9414 0x941e 0x941f 0x9434 0x943c)))
(allow fvca_management_broker_t fvca_vm_slot_t (dir (getattr ioctl open read search)))
(allowx fvca_management_broker_t fvca_vm_slot_t (ioctl dir (0x943c)))
(allow fvca_management_broker_t sysfs_t (dir (open read)))

(type fvca_management_intents_t)
(typeattributeset file_type (fvca_management_intents_t))
(roletype object_r fvca_management_intents_t)
(allow fvca_management_intents_t fs_t (filesystem (associate)))
(allow init_t fvca_management_intents_t (dir (getattr open read relabelfrom relabelto search)))
(allow fvca_management_broker_t fvca_management_intents_t (dir (add_name getattr open read remove_name search write)))

(type fvca_management_intent_t)
(typeattributeset file_type (fvca_management_intent_t))
(roletype object_r fvca_management_intent_t)
(allow fvca_management_intent_t fs_t (filesystem (associate)))
(typetransition fvca_management_broker_t fvca_management_intents_t file fvca_management_intent_t)
(allow fvca_management_broker_t fvca_management_intent_t (file (create getattr open read rename setattr unlink write)))
(allow init_t fvca_management_intent_t (file (getattr open read)))

(type fvca_attestation_socket_t)
(typeattributeset file_type (fvca_attestation_socket_t))
(roletype object_r fvca_attestation_socket_t)
(filecon "/run/fvca-attestation" dir (system_u object_r fvca_attestation_socket_t ((s0) (s0))))
(filecon "/run/fvca-attestation/quote\.sock" socket (system_u object_r fvca_attestation_socket_t ((s0) (s0))))
(allow fvca_attestation_socket_t tmpfs_t (filesystem (associate)))
(allow init_t fvca_attestation_socket_t (dir (add_name create getattr open read remove_name rmdir search setattr write)))
(allow init_t fvca_attestation_socket_t (sock_file (create getattr relabelto setattr unlink write)))
(allow init_t fvca_attestation_t (unix_stream_socket (accept bind create getattr getopt ioctl listen read setopt shutdown write)))
(allow fvca_management_broker_t fvca_attestation_socket_t (dir (getattr search)))
(allow fvca_management_broker_t fvca_attestation_socket_t (sock_file (getattr write)))
(allow fvca_management_broker_t fvca_attestation_t (unix_stream_socket (connectto)))
(allow fvca_attestation_t self (unix_stream_socket (getattr getopt read setopt write)))
(allow fvca_attestation_t tpm_device_t (chr_file (getattr open read write)))
