; Only the scheduled worker gets the scrub ioctl and writable receipt state.
(type fvca_storage_scrub_t)
(type fvca_storage_scrub_state_t)
(typeattributeset domain (fvca_storage_scrub_t))
(typeattributeset file_type (fvca_storage_scrub_state_t))
(roletype system_r fvca_storage_scrub_t)
(roletype object_r fvca_storage_scrub_state_t)

(allow init_t fvca_storage_scrub_t (process (getattr sigkill signal transition)))
(allow init_t fvca_storage_scrub_t (process2 (nnp_transition)))
(allow fvca_storage_scrub_t init_t (process (sigchld)))
(allow fvca_storage_scrub_t init_t (fd (use)))
(allow fvca_storage_scrub_t init_t (unix_stream_socket (getattr read write)))
(allow fvca_storage_scrub_t syslogd_t (unix_stream_socket (getattr write)))
(allow fvca_storage_scrub_t self (process (getattr getcap)))
(allow fvca_storage_scrub_t self (file (getattr open read)))
(allow fvca_storage_scrub_t self (capability (sys_admin)))

(allow fvca_storage_scrub_t bin_t (file (entrypoint execute getattr map open read)))
(allow fvca_storage_scrub_t bin_t (dir (getattr search)))
(allow fvca_storage_scrub_t usr_t (dir (getattr search)))
(allow fvca_storage_scrub_t lib_t (dir (getattr search)))
(allow fvca_storage_scrub_t lib_t (file (execute getattr map open read)))
(allow fvca_storage_scrub_t ld_so_t (file (execute getattr map open read)))
(allow fvca_storage_scrub_t ld_so_cache_t (file (getattr map open read)))
(allow fvca_storage_scrub_t etc_t (dir (getattr search)))
(allow fvca_storage_scrub_t etc_t (file (getattr open read)))
(allow fvca_storage_scrub_t etc_t (lnk_file (getattr read)))
(allow fvca_storage_scrub_t root_t (dir (getattr search)))
(allow fvca_storage_scrub_t device_t (dir (getattr search)))
(allow fvca_storage_scrub_t urandom_device_t (chr_file (getattr open read)))
(allow fvca_storage_scrub_t null_device_t (chr_file (getattr open read write)))
(allow fvca_storage_scrub_t proc_t (dir (getattr search)))
(allow fvca_storage_scrub_t proc_t (file (getattr open read)))
(allow fvca_storage_scrub_t proc_t (lnk_file (getattr read)))
(allow fvca_storage_scrub_t sysctl_t (dir (getattr search)))
(allow fvca_storage_scrub_t sysctl_kernel_t (dir (getattr search)))
(allow fvca_storage_scrub_t sysctl_kernel_t (file (getattr open read)))
(allow fvca_storage_scrub_t sysfs_t (dir (getattr open read search)))
(allow fvca_storage_scrub_t sysfs_t (file (getattr open read)))
(allow fvca_storage_scrub_t security_t (dir (getattr search)))
(allow fvca_storage_scrub_t security_t (file (getattr open read)))
(allow fvca_storage_scrub_t var_run_t (dir (getattr search)))
(allow fvca_storage_scrub_t var_run_t (file (getattr open read)))
(allow fvca_storage_scrub_t tmpfs_t (dir (getattr search)))
(allow fvca_storage_scrub_t tmpfs_t (file (getattr open read)))
(allow fvca_storage_scrub_t init_var_run_t (dir (getattr search)))
(allow fvca_storage_scrub_t init_var_run_t (file (getattr open read)))
(allow fvca_storage_scrub_t fs_t (filesystem (getattr)))

(allow fvca_storage_scrub_state_t fs_t (filesystem (associate)))
(allow init_t fvca_storage_scrub_state_t (dir (create getattr open read search)))
(allow fvca_storage_scrub_t fvca_storage_scrub_state_t (dir (add_name getattr open read remove_name search write)))
(allow fvca_storage_scrub_t fvca_storage_scrub_state_t (file (create getattr open read rename setattr unlink write)))

(optional fvca_storage_scrub_host
    (typetransition init_t fvca_host_data_t dir ".fvca-scrub" fvca_storage_scrub_state_t)
    (allow fvca_storage_scrub_t fvca_host_data_t (dir (getattr ioctl open read search)))
    (allowx fvca_storage_scrub_t fvca_host_data_t (ioctl dir (0x9414 0x941b 0x941e 0x941f))))

(optional fvca_storage_scrub_guest
    (typetransition init_t fvca_guest_data_t dir ".fvca-scrub" fvca_storage_scrub_state_t)
    (allow fvca_storage_scrub_t fvca_guest_data_t (dir (getattr ioctl open read search)))
    (allowx fvca_storage_scrub_t fvca_guest_data_t (ioctl dir (0x9414 0x941b 0x941e 0x941f))))

(optional fvca_storage_scrub_management
    (allow fvca_management_broker_t fvca_storage_scrub_state_t (dir (getattr open read search)))
    (allow fvca_management_broker_t fvca_storage_scrub_state_t (file (getattr open read))))
