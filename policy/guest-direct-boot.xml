<domain type='kvm'>
  <name>fvca-service-guest</name>
  <uuid>e629aa43-af11-47c6-aedc-a2dc47f1cc3a</uuid>
  <memory unit='MiB'>2048</memory>
  <vcpu placement='static'>2</vcpu>
  <os>
    <type arch='x86_64' machine='pc-q35-11.1'>hvm</type>
    <kernel>/run/fvca/guest-boot/linux</kernel>
    <initrd>/run/fvca/guest-boot/initrd</initrd>
    <cmdline>FVCA_SIGNED_COMMAND_LINE</cmdline>
  </os>
  <features>
    <acpi/>
    <apic/>
  </features>
  <cpu mode='host-passthrough' migratable='off'>
    <feature policy='disable' name='vmx'/>
  </cpu>
  <seclabel type='dynamic' model='selinux' relabel='yes'/>
  <devices>
    <emulator>/usr/bin/qemu-system-x86_64</emulator>
    <controller type='usb' model='none'/>
    <video><model type='none'/></video>
    <memballoon model='none'/>
    <serial type='pty'><target type='isa-serial' port='0'/></serial>
    <disk type='file' device='disk'>
      <driver name='qemu' type='raw'/>
      <source file='/run/fvca/guest-boot/core.raw'/>
      <target dev='vda' bus='virtio'/>
      <readonly/>
    </disk>
    <disk type='file' device='disk'>
      <driver name='qemu' type='raw'/>
      <source file='/run/fvca/guest-boot/runtime.raw'/>
      <target dev='vdb' bus='virtio'/>
      <readonly/>
    </disk>
    <disk type='file' device='disk'>
      <driver name='qemu' type='raw' cache='none' io='threads'/>
      <source file='/run/fvca/guest-state.raw'/>
      <target dev='vdc' bus='virtio'/>
    </disk>
  </devices>
</domain>
