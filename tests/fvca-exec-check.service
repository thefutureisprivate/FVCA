[Unit]
Description=Test FVCA execution policy
AssertSecurity=uefi-secureboot
Requires=sys-kernel-tracing.mount
After=sys-kernel-tracing.mount

[Service]
Type=oneshot
ExecStart=/usr/lib/fvca/exec-check
RuntimeDirectory=fvca-exec-check
RuntimeDirectoryMode=0700
StandardOutput=journal+console
NoNewPrivileges=yes
RemainAfterExit=yes
