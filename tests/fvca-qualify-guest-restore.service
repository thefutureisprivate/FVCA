ExecStart=/usr/bin/systemctl --quiet is-active fvca-service-guest.service
ExecStart=/usr/bin/test ! -e /run/fvca/host-data/captures/restores/863333ec-9e20-4f6a-8f08-d636cd99e466/branch
ExecStart=/usr/bin/test -s /run/fvca/host-data/captures/restores/863333ec-9e20-4f6a-8f08-d636cd99e466/verified
ExecStart=/usr/bin/test ! -e /run/fvca/host-data/captures/restores/active
ExecStart=/usr/bin/systemctl start fvca-capture-live@9b5c817b-c896-4d9a-b664-b962468fd00c.service
