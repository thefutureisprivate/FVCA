[Unit]
Description=Activate the UKI-authorized FVCA VM runtime
DefaultDependencies=no
Requires=sysroot.mount systemd-ask-password-console.path
After=sysroot.mount systemd-ask-password-console.path systemd-pcrphase-initrd.service systemd-pcrosseparator.service systemd-tmpfiles-setup.service
AssertSecurity=uefi-secureboot
AssertSecurity=selinux

[Service]
Type=oneshot
ExecStartPre=/usr/bin/modprobe --ignore-install kvm_intel nested=0
ExecStart=/usr/lib/fvca/activate-runtime
RemainAfterExit=yes
TimeoutStartSec=105s
StandardOutput=journal+console
NoNewPrivileges=yes
